    {
      "type": "row",
      "title": "0 - Error Budget (30 days)  |  0.1% of 30 days = 43.2 min",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Budget Remaining",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "min": -1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "slo:rpc_error_budget_remaining:30d"
        }
      ],
      "description": "Share of the 43.2-minute budget not yet spent: 1 - failed minutes / 43.2. 100% means no failed probe in the window. Negative means over budget."
    },
    {
